// Define layer number aliases.
#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define NUMPAD 4

#include <behaviors/mouse_keys.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

//#include <dt-bindings/led/led.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10
#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  //  600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

// Emulates mouse scrolling
&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};
// Emulates mouse movement
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

// Encoders. Don't use. Changes char spacing when using with arrow keys.
//&sensors { triggers-per-rotation = <22>; };
//&left_encoder { steps = <30>; };
//&right_encoder { steps = <30>; };
//&led_strip { chain-length = <29>; };

// Setup of CS pin from nice!view display.
&nice_view_spi {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    //cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>;  // use D0 (008) for CS niceview + rgb
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;  // use D4 (022) for CS niceview + rgb
};

/ {

    behaviors {

        Shift_Enter: Shift_Enter {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_ENTER";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            hold-trigger-key-positions = <34>;
            tapping-term-ms = <100>;
        };

	switch_tasks: switch-tasks {
		compatible = "zmk,behavior-sensor-rotate";
		label = "SWITCH_TASKS";
		#sensor-binding-cells = <0>;
		bindings = <&tasks_forward>, <&tasks_backward>;
	};

        fast_encoder: fast_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&macro_fast_vol_dn>, <&macro_fast_vol_up>;
        };        

        rgb_encoder_bri: rgb_encoder_bri {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRD>, <&rgb_ug RGB_BRI>;
        };

        rgb_encoder_hu: rgb_encoder_hu {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUD>, <&rgb_ug RGB_HUI>;
        };

        rgb_encoder_sa: rgb_encoder_sa {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_SAD>, <&rgb_ug RGB_SAI>;
        };

        lang_switch: Lang_Switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(N1))>, <&kp LA(LS(N2))>, <&kp LA(LEFT_SHIFT)>;

            label = "Language switch (Alt+Shift+N)";
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
        };
        hs: homerow_shifts {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFTS";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "balanced";
        };
        hsl: homerow_shifts_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFTS_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&to>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "RGB_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <100>;
            // tap-ms = <30>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <POUND MINUS BACKSPACE UNDERSCORE>;
        };

	td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

    };

    macros {

		tasks_forward: tasks-forward {
			label = "TAKS_FORWARD";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&macro_press   &kp LALT>,
				   <&macro_tap     &kp TAB>,
				   <&macro_release &kp LALT>;
		};

		tasks_backward: tasks-backward {
			label = "TAKS_BACKWARD";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&macro_press   &kp LALT>,
				   <&macro_press   &kp LSHIFT>,
				   <&macro_tap     &kp TAB>,
				   <&macro_release &kp LSHIFT>,
				   <&macro_release &kp LALT>;
		};

        macro_fast_vol_up: macro_fast_vol_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp C_VOL_UP &kp C_VOL_UP>;
        };

        macro_fast_vol_dn: macro_fast_vol_dn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp C_VOL_DN &kp C_VOL_DN>;
        };

        NTIL: NTIL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N1 &kp KP_N6 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        flash_macro: flash_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bootloader>;
        };
        
        // System and Power
        tm: tm {
            label = "TASK_MANAGER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp ESC>
                , <&macro_release &kp LCTRL &kp LSHFT>
                ;
        };
        cad: cad{
            label = "CTRL_ALT_DEL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp DEL>
                , <&macro_release &kp LCTRL &kp LALT &kp DEL>
                ;
        };
        slp: slp {
            label = "SLEEP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp X>
                , <&macro_release &kp LGUI>
                , <&macro_tap &kp U &kp S>
                ;
        };
        rst: rst {
            label = "RESTART";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp X>
                , <&macro_release &kp LGUI>
                , <&macro_tap &kp U &kp R>
                ;
        };
        off: off {
            label = "SHUTDOWN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp X>
                , <&macro_release &kp LGUI>
                , <&macro_tap &kp U &kp U>
                ;
        };

    };

    // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            //display-name = "";		// This defaults to "LAYER 0" if left empty.
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp DEL
&kp GRAVE &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp HOME   &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LGUI &kp LALT &kp LCTRL &mo LOWER  &kp RET    &kp SPACE  &mo RAISE  &kp RCTRL &kp RALT  &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&scroll_encoder>;
            //sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp PG_UP PG_DN>;
            //sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_cp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
            // sensor-bindings = <&rgb_encoder_bri &inc_dec_kp PG_UP PG_DN>;
            // sensor-bindings = <&rgb_encoder_hu &rgb_encoder_sa>;
            // sensor-bindings = <&fast_encoder &inc_dec_kp PG_UP PG_DN>;
            // sensor-bindings = <&inc_dec_kp SCRL_UP SCRL_DOWN>;
        };

        lower_layer {
            display-name = "Lower";
// TODO: Some binds are waiting for shifted keycode support.
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
// |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&tog NUMPAD           &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                      &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
&trans                &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                      &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
&tm                   &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                   &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&kp C_AL_MY_COMPUTER  &kp EQUAL &kp MINUS &kp PLUS    &kp LBRC  &kp RBRC   &kp RET  &kp RET &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
                      &trans    &trans      &trans    &trans    &trans     &trans   &trans  &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>, <&inc_dec_kp UP DOWN>;
            //sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>, <&inc_dec_kp UP_ARROW DOWN_ARROW>;
            //sensor-bindings = <&inc_dec_kp LEFT RIGHT>;

        };

        raise_layer {
            display-name = "Raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
// |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR            &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                   &trans          &trans    &trans   &trans    &trans  &kp DEL
&trans                &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                         &kp PG_UP       &kp HOME  &kp UP   &kp END   &kp N0  &kp BSPC
&tm                   &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                       &kp PG_DN       &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans                &kp K_AGAIN  &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE   &kp RET  &trans  &trans          &trans    &trans   &trans    &trans  &trans
                      &trans       &trans       &trans       &trans       &trans        &trans   &trans  &trans          &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>,<&rgb_encoder_sa>;
//          sensor-bindings = <&scroll_encoder>;             // Fails? intended for different sensor?
        };

        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "Adjust";
            bindings = <
&trans                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &kp C_AL_CALC        &trans           &mt RC(KP_DIVIDE) KP_DIVIDE  &mt RC(KP_MULTIPLY) KP_MULTIPLY  &mt RC(KP_MINUS) KP_MINUS   &kp DEL
&bt BT_CLR            &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &kp PG_UP            &kp KP_N7        &kp KP_NUMBER_8              &kp KP_NUMBER_9                  &mt RC(KP_PLUS) KP_PLUS     &kp BSPC
&soft_off             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &rgb_ug RGB_EFR                         &kp PG_DN            &kp KP_N4        &kp KP_NUMBER_5              &kp KP_NUMBER_6                  &none                       &none 
&kp C_AL_MY_COMPUTER  &kp K_AGAIN     &kp K_UNDO      &kp K_CUT       &kp K_COPY      &kp K_PASTE     &rgb_ug RGB_TOG &none   &kp KP_DOT           &kp KP_N1        &kp KP_N2                    &kp KP_NUMBER_3                  &none                       &none
                                      &trans          &trans          &trans          &trans          &trans          &trans  &trans               &kp KP_NUMBER_0  &kp KP_DOT                   &kp KP_ENTER                         
            >;

            sensor-bindings = <&rgb_encoder_bri>,<&rgb_encoder_hu>;
            //sensor-bindings = <&rgb_encoder &scroll_encoder>;

        };

        numpad_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "NumPad";
            bindings = <
&tog NUMPAD           &trans          &trans          &trans          &trans          &trans                                  &kp C_AL_CALC        &trans           &mt RC(KP_DIVIDE) KP_DIVIDE  &mt RC(KP_MULTIPLY) KP_MULTIPLY  &mt RC(KP_MINUS) KP_MINUS   &kp DEL
&tog NUMPAD           &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &kp PG_UP            &kp KP_N7        &kp KP_NUMBER_8              &kp KP_NUMBER_9                  &mt RC(KP_PLUS) KP_PLUS     &kp BSPC
&trans                &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &rgb_ug RGB_EFR                         &kp PG_DN            &kp KP_N4        &kp KP_NUMBER_5              &kp KP_NUMBER_6                  &trans                       &trans 
&trans                &kp K_AGAIN     &kp K_UNDO      &kp K_CUT       &kp K_COPY      &kp K_PASTE     &rgb_ug RGB_TOG &none   &kp KP_DOT           &kp KP_N1        &kp KP_N2                    &kp KP_NUMBER_3                  &trans                       &trans
                                      &trans          &trans          &trans          &trans          &trans          &trans  &trans               &kp KP_NUMBER_0  &kp KP_DOT                   &kp KP_ENTER                         
            >;

            sensor-bindings = <&rgb_encoder_bri>,<&rgb_encoder_hu>;
            //sensor-bindings = <&rgb_encoder &scroll_encoder>;

        };
};

    // ZMK ESB Split Transport
    // https://github.com/badjeff/zmk-feature-split-esb
    //esb_split {
    //    compatible = "zmk,esb-split";
    //    // These are arbitrary default addresses. In end user products
    //    // different addresses should be used for each set of devices.
    //    base-addr-0 = <0xE7 0xE7 0xE7 0xE7>;
    //    base-addr-1 = <0xC2 0xC2 0xC2 0xC2>;
    //    addr-prefix = <0xE7 0xC2 0xC3 0xC4 0xC5 0xC6 0xC7 0xC8>;
    //};

};

/*
Fails:
&kp C_AL_TASK_MANAGER
&kp C_AL_SCREEN_SAVER
*/
